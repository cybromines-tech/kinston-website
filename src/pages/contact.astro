---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { breadcrumbLd } from '../lib/seo';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
---
<Base title="Contact Kinston Lifting" description="Request a quote or talk to an engineer using our enquiry form." path="/contact" jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero eyebrow="LET’S TALK LIFTING" image="/images/page-heroes/contact-branded.webp">
<Breadcrumb items={crumbs} light />
      <h1>Contact</h1>
      <p class="lede">Quotes, sling designs, certificates and technical questions. Send the form and an engineer will reply within one working day.</p>
  </PageHero>
  <section class="section">
    <div class="wrap contact-form">
      <EnquiryForm heading="Request a quote" />
    </div>
  </section>
</Base>
<style>
  .contact-form { max-width: 820px; }
</style>
